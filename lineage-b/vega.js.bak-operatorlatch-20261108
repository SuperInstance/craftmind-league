// SUBSTRATE (declared 2026-11-07, see README addendum): canopy-descent
// reflex. NOT a skill and never presented as one: if Vega is standing on
// leaves with no solid ground within 4 blocks below and no skill is
// running, dig the block beneath and drop, step by step, until she stands
// on ground — the descent her author mind kept prescribing in words but
// whose executions died in pathfinding timeouts. Every firing is logged
// as SUBSTRATE. (Same pattern as Lineage C's `descend` executor and
// canopy substrate, adopted as a body reflex here.)
let descentBusy = false;
async function canopyDescentReflex() {
  if (descentBusy || tickBusy || !bot || !spawned || !bot.entity) return;
  try {
    const feet0 = bot.entity.position.floored();
    const under = bot.blockAt(feet0.offset(0, -1, 0));
    if (!under || !/leaves$/.test(under.name)) return;
    for (let d = 2; d <= 4; d++) {
      const b = bot.blockAt(feet0.offset(0, -d, 0));
      if (b && b.boundingBox === "block" && !/leaves$/.test(b.name)) return; // ground close below: fine
    }
    descentBusy = true;
    log("SUBSTRATE canopy-descent: standing on leaves, no ground within 4 below — digging down");
    const GROUND = ["grass_block", "dirt", "stone", "sand", "gravel", "coarse_dirt", "podzol", "mycelium", "cobblestone", "bedrock", "clay", "sandstone", "dirt_path"];
    for (let step = 0; step < 12; step++) {
      if (tickBusy) break;
      const feet = bot.entity.position.floored();
      const below = bot.blockAt(feet.offset(0, -1, 0));
      if (!below) break;
      if (GROUND.includes(below.name)) break;
      if (below.boundingBox === "empty") { await helpers.sleep(350); continue; }
      try { await bot.dig(below); } catch (e) { log("SUBSTRATE canopy-descent: dig failed:", e.message); break; }
      await helpers.sleep(450);
    }
    const p = bot.entity.position;
    const un = bot.blockAt(p.offset(0, -1, 0));
    log("SUBSTRATE canopy-descent: done at", p.x.toFixed(1), p.y.toFixed(1), p.z.toFixed(1), "standingOn", un ? un.name : null);
  } catch {}
  descentBusy = false;
}

