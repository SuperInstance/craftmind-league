// geist.js — Lineage C resident: "Geist", the Deliberator (GITM pattern).
//
// One process holds: the body (mineflayer), the state feed, the declared
// survival substrate, the night watch (S5 verdict), the operator command
// channel, and the PULSE — every ~10 minutes the three minds tick:
// PLANNER composes a plan from the closed vocabulary over the fact files,
// CALCULATOR checks its arithmetic against those facts, the body executes
// it open-loop, REFLECTION writes the outcome into text memory. A failed
// action stops the plan, triggers reflection, and replans (cap 3 per tick).
// Verdicts come from verify.js reading the world, never from the plan.
//
// Run from this directory:  node geist.js
// Env overrides: MC_HOST (192.168.0.50), MC_PORT (25565), MC_USER (Geist),
// MC_VERSION (26.1), PULSE_MS (600000).
const fs = require("fs");
const path = require("path");
process.chdir(__dirname);

const mineflayer = require("mineflayer");
const { pathfinder, Movements, goals } = require("mineflayer-pathfinder");
const ex = require("./executors");
const verify = require("./verify");
const minds = require("./minds");

const DIR = __dirname;
const LEAGUE = path.dirname(DIR);
const F = {
  state: path.join(DIR, "geist-state.json"),
  anchor: path.join(DIR, "anchor.json"),
  progress: path.join(DIR, "progress.json"),
  ticks: path.join(DIR, "logs", "ticks.jsonl"),
  command: path.join(DIR, "command.json"),
  commandResult: path.join(DIR, "command-result.json"),
  scoreboard: path.join(LEAGUE, "commons", "SCOREBOARD.jsonl"),
  pond: path.join(LEAGUE, "commons", "pond"),
};
const OPTS = {
  host: process.env.MC_HOST || "192.168.0.50",
  port: parseInt(process.env.MC_PORT || "25565", 10),
  username: process.env.MC_USER || "Geist",
  version: process.env.MC_VERSION || "26.1",
};
const PULSE_MS = parseInt(process.env.PULSE_MS || "600000", 10);

// The shared exam — identical ladder to pulse/curriculum.json (A) and
// lineage-b/exam.js (B). Goals are the curriculum's own words.
const STAGES = [
  { id: "S1", name: "Gather + tools", criteria: "Crafting table (carried or placed within 20 blocks) AND a wooden pickaxe in inventory.",
    goal: "Find trees, dig logs, and work up to your first tools. Recipe chain: logs -> planks (2x2 grid) -> sticks; 4 planks -> crafting table (2x2 grid); place the table, stand next to it, then 3 planks + 2 sticks -> wooden pickaxe (needs the table)." },
  { id: "S2", name: "Stone", criteria: "A stone pickaxe in inventory, and cobblestone seen in inventory (proof of mining).",
    goal: "Use the wooden pickaxe to mine stone (exposed rock, cliff faces, stream beds): collect cobblestone, then craft a stone pickaxe at the crafting table (3 cobblestone + 2 sticks)." },
  { id: "S3", name: "Shelter", criteria: "An enclosed, roofed volume within ~26 blocks of the anchor with a door block and a torch inside (block-scan evidence).",
    goal: "Build a small enclosed, roofed shelter at your anchor using facts/shelter.md: walls with no gaps, a roof, a wooden door installed in the doorway, and a torch inside. Torch needs 1 stick + 1 coal or charcoal; coal ore is common in exposed stone." },
  { id: "S4", name: "Furnish", criteria: "A chest inside the shelter volume containing at least 8 stored items.",
    goal: "Craft a chest (8 planks at the table), place it INSIDE the shelter, and deposit at least 8 surplus items into it (keep your tools)." },
  { id: "S5", name: "The night", criteria: "One full night (timeOfDay 13000->23000) with zero deaths, inside or within 6 blocks of the shelter at mid-night. (Monitored continuously by the resident loop.)",
    goal: "When dusk approaches (timeOfDay ~12000), go inside the shelter and stay until dawn. Eat if you have food; do not wander out." },
];

function log(...a) { console.log(new Date().toISOString(), "[GEIST]", ...a); }
function readJson(p, fallback) { try { return JSON.parse(fs.readFileSync(p, "utf8")); } catch { return fallback; } }
function writeJson(p, o) { fs.writeFileSync(p, JSON.stringify(o, null, 2)); }
function appendLine(p, o) { fs.appendFileSync(p, JSON.stringify(o) + "\n"); }
function scoreboard(stage, event, evidence) {
  appendLine(F.scoreboard, { ts: new Date().toISOString(), lineage: "C", citizen: "Geist", stage, event, evidence });
}

// ---------------- persistent state ----------------
let anchor = readJson(F.anchor, null);
if (!anchor) { anchor = { x: 7, y: 67, z: -85, provisional: true }; writeJson(F.anchor, anchor); } // HOME; the old pond default (-16, 74, -78) retired 2026-11-07
let progress = readJson(F.progress, null);
if (!progress) {
  progress = { citizen: "Geist", lineage: "C", deaths: 0, maxSeen: {}, shelter: null,
    stages: STAGES.map((s) => ({ id: s.id, status: "pending", attempts: 0, passedAt: null, lastEvidence: null })) };
  writeJson(F.progress, progress);
}
const ctx = { anchor, shelter: progress.shelter || null };

let bot = null, spawned = false, busy = false, deaths = progress.deaths || 0, relaunches = 0, greeted = false;
let night = { active: false, deaths0: 0, midOk: null, midPos: null };

function stageRec(id) { return progress.stages.find((s) => s.id === id); }
function currentStage() {
  const rec = progress.stages.find((s) => s.status !== "pass");
  return rec ? STAGES.find((s) => s.id === rec.id) : null;
}
function saveProgress() { progress.deaths = deaths; progress.shelter = ctx.shelter; writeJson(F.progress, progress); }

// ---------------- state snapshot ----------------
function snapshot() {
  if (!bot || !spawned) return null;
  const p = bot.entity.position;
  return {
    citizen: "Geist", lineage: "C",
    position: { x: +p.x.toFixed(1), y: +p.y.toFixed(1), z: +p.z.toFixed(1) },
    health: bot.health, food: bot.food, oxygen: bot.oxygenLevel == null ? 20 : bot.oxygenLevel,
    timeOfDay: bot.time ? bot.time.timeOfDay : null,
    inventory: ex.inventory(bot),
    deaths, stage: (currentStage() || {}).id || "DONE",
    anchor: { x: anchor.x, y: anchor.y, z: anchor.z },
  };
}
function survey() {
  const kinds = ["oak_log", "spruce_log", "birch_log", "jungle_log", "acacia_log", "dark_oak_log", "stone", "coal_ore", "crafting_table", "chest", "dirt"];
  const out = {};
  for (const k of kinds) { try { out[k] = ex.findBlocks(bot, k, 48, 30).length; } catch { out[k] = 0; } }
  out.log = ex.findBlocks(bot, "log", 48, 30).length;
  return out;
}

// ---------------- plan execution ----------------
async function executePlan(plan) {
  const results = [];
  for (const step of plan.actions) {
    const r = await ex.runAction(bot, ctx, step);
    results.push({ action: step.action, args: step.args, ok: r.ok, evidence: r.evidence || null, error: r.error || null });
    log("  action", step.action, JSON.stringify(step.args), "->", r.ok ? "ok" : "FAIL: " + r.error);
    if (!r.ok) break; // open-loop until an action fails — then reflect + replan
  }
  return results;
}

async function checkStage(stage) {
  const fn = verify.CHECKS[stage.id];
  if (!fn) return { ok: false, evidence: { reason: "no checker (monitored stage)" } };
  return fn(bot, ctx);
}

function publishPlanToPond(stage, plan, verdict) {
  try {
    fs.mkdirSync(F.pond, { recursive: true });
    const file = path.join(F.pond, `C-plan-${stage.id}.md`);
    const body = [
      `<!-- pond: lineage C (the Deliberator, GITM pattern), citizen Geist, stage ${stage.id}, ${new Date().toISOString()}`,
      `provenance: plan composed by Geist's PLANNER + CALCULATOR over the closed action vocabulary;`,
      `verdict: PASSED from world evidence: ${JSON.stringify(verdict.evidence).slice(0, 400)} -->`,
      `# Geist's passing ${stage.id} plan (${stage.name}) — a successful action list, free to adopt`,
      "```json",
      JSON.stringify(plan, null, 1),
      "```",
      "",
    ].join("\n");
    fs.writeFileSync(file, body);
    log("published passing plan to pond:", file);
  } catch (e) { log("pond publish failed:", e.message); }
}

// ---------------- the pulse ----------------
async function tick(reason) {
  if (busy || !bot || !spawned) return;
  const stage = currentStage();
  if (!stage) { log("tick: exam complete"); return; }
  busy = true;
  const tickId = new Date().toISOString();
  log(`tick (${reason}) — stage ${stage.id}: ${stage.name}`);
  try {
    if (stage.id === "S5") { log("tick: S5 is monitored by the night watch; no plan issued"); return; }
    const rec = stageRec(stage.id);
    // refresh shelter knowledge for the later stages
    if (stage.id === "S4") { const s = verify.scanShelter(bot, anchor); if (s.ok) { ctx.shelter = s.evidence; saveProgress(); } }

    // pond as facts (spec: before planning S3+, read the pond; we read it at
    // every stage — it is cheap — and record influence from the plan itself)
    let pondNotes = [];
    try {
      const files = fs.readdirSync(F.pond).filter((f) => !f.startsWith("C-"));
      for (const f of files.slice(0, 6)) {
        const head = fs.readFileSync(path.join(F.pond, f), "utf8").split("\n").slice(0, 18).join("\n");
        pondNotes.push(`### pond/${f}\n${head}`);
      }
      if (files.length) log(`pond: read ${files.length} non-C item(s) as facts: ${files.join(", ")}`);
    } catch {}

    const stateBefore = { ...snapshot(), survey: survey() };
    const memories = minds.retrieveMemories(`${stage.id} ${stage.name} ${stage.goal}`, 3);
    let feedback = null;
    let finalPlan = null, finalResults = null, verdict = null;

    for (let attempt = 1; attempt <= 3; attempt++) {
      const p = await minds.planner({ stage, state: stateBefore, anchor, memories, pondNotes, feedback });
      if (!p.plan) {
        feedback = "Your last reply was not a valid plan. Parse/validation errors: " + p.errors.join("; ") + ". Reply with ONE JSON plan object only.";
        log("planner output invalid:", p.errors.join("; "));
        appendLine(F.ticks, { ts: tickId, stage: stage.id, attempt, event: "plan-invalid", errors: p.errors, rawHead: (p.raw || "").slice(0, 300) });
        continue;
      }
      let plan = p.plan;
      const calc = await minds.calculator({ stage, state: stateBefore, plan });
      appendLine(F.ticks, { ts: tickId, stage: stage.id, attempt, event: "calculated", ok: calc.ok, reason: calc.reason || null, revised: !!calc.revised, usedPond: plan.usedPond || [] });
      if (!calc.ok) {
        feedback = "The CALCULATOR bounced your plan: " + calc.reason + " Replan answering exactly that.";
        log("calculator bounce:", calc.reason);
        continue;
      }
      if (calc.revised) { plan = calc.revised; log("calculator revised the plan (counts/targets)"); }
      if (plan.usedPond && plan.usedPond.length) log("plan declares pond influence:", plan.usedPond.join(", "));

      rec.attempts++;
      scoreboard(stage.id, "attempt", { tick: tickId, attempt, actions: plan.actions.length, usedPond: plan.usedPond || [] });
      finalPlan = plan;
      finalResults = await executePlan(plan);
      const allOk = finalResults.every((r) => r.ok);
      verdict = await checkStage(stage);
      if (verdict.ok) {
        rec.status = "pass"; rec.passedAt = new Date().toISOString(); rec.lastEvidence = verdict.evidence;
        scoreboard(stage.id, "pass", verdict.evidence);
        publishPlanToPond(stage, plan, verdict);
        log(`STAGE ${stage.id} PASS`, JSON.stringify(verdict.evidence).slice(0, 300));
      } else {
        rec.lastEvidence = verdict.evidence;
        const failed = finalResults.find((r) => !r.ok);
        feedback = allOk
          ? "Your plan executed fully, but the stage verdict still fails. Verdict evidence: " + JSON.stringify(verdict.evidence).slice(0, 500) + ". Replan to close exactly that gap."
          : `Your plan stopped at action "${failed.action}" ${JSON.stringify(failed.args)} — error: ${failed.error}. Evidence so far: ` + JSON.stringify(finalResults.map((r) => [r.action, r.ok])).slice(0, 400) + ". Replan from the live state (which has moved on) around that failure.";
        log(`stage ${stage.id} not passed (attempt ${attempt}) — ${allOk ? "verdict gap" : "action failure"}`);
      }
      // reflection after every executed plan
      try {
        const entry = await minds.reflect({ stage, stateBefore, plan, results: finalResults, verdict });
        minds.appendMemory(`${new Date().toISOString()} stage=${stage.id} result=${verdict.ok ? "pass" : "fail"}`, entry);
        log("reflection written to memory/plans.md");
      } catch (e) { log("reflection failed:", e.message); }
      saveProgress();
      if (verdict.ok) break;
    }
    if (!verdict || !verdict.ok) {
      scoreboard(stage.id, "fail", { tick: tickId, note: "tick exhausted replans without a pass", lastEvidence: rec.lastEvidence });
      log(`tick ends: ${stage.id} still open`);
    }
  } catch (e) {
    log("tick error:", e.message);
    appendLine(F.ticks, { ts: tickId, stage: stage.id, event: "tick-error", error: e.message });
  } finally { busy = false; lastTickEnd = Date.now(); }
}

// ---------------- operator command channel (smoke tests / inspection) -------
// Drop {"actions":[...]} into command.json; the resident executes them
// through the same executor path a plan uses and writes command-result.json.
async function runCommandFile() {
  if (busy || !bot || !spawned) return;
  let cmd;
  try { cmd = JSON.parse(fs.readFileSync(F.command, "utf8")); } catch { return; }
  busy = true;
  try {
    log("command file received:", JSON.stringify(cmd).slice(0, 200));
    const results = [];
    for (const step of cmd.actions || []) {
      const r = await ex.runAction(bot, ctx, step);
      results.push({ action: step.action, args: step.args, ok: r.ok, evidence: r.evidence || null, error: r.error || null });
      if (!r.ok) break;
    }
    writeJson(F.commandResult, { ts: new Date().toISOString(), results, state: snapshot() });
    fs.unlinkSync(F.command);
    log("command file executed");
  } catch (e) { log("command file error:", e.message); }
  finally { busy = false; }
}

// ---------------- body ----------------
function launch() {
  log(`launching Geist (attempt ${relaunches + 1})`, OPTS);
  bot = mineflayer.createBot(OPTS);
  bot.loadPlugin(pathfinder);

  bot.once("spawn", () => {
    spawned = true;
    // Travel movements. HISTORY: this shipped walk-only (canDig=false) on
    // Lineage B's field finding that digging-enabled A* churned on ~9-block
    // hops. Substrate repair 2026-11-07 (see README addendum): canDig=true.
    // Controlled probes that day showed the real failure was never a server
    // pin (there is none — see repair-cody/): with digging forbidden, any
    // route whose only continuation is through a step, trunk or leaf block
    // has NO legal plan, and the pathfinder follow loop then churns in
    // stuck-resets until the caller's budget dies. Paired with the shorter
    // hops in executors.gotoPos (<=6 blocks, so A* stays local), digging in
    // travel planning is what lets a route exist at all in this forest.
    // allow1by1towers stays false: no towering, ever.
    const mv = new Movements(bot);
    mv.canDig = true;
    mv.allow1by1towers = false;
    // Substrate (2026-11-07, mirrors Lineage B's verified repair):
    // maxDropDown 4 (default) -> 10, so the pathfinder can route
    // multi-block descents (canopy -> lower canopy -> ground) instead of
    // reporting no-path on stepped drops.
    mv.maxDropDown = 10;
    // NOTE (2026-11-07): a leaf_litter step-exclusion (cost 100 via
    // exclusionAreasStep) was tried and REVERTED the same day: at Geist's
    // verification bowl (0,62,-83) it produced zero movement in 90 s
    // (every local route crosses litter; A* budgets died on detours),
    // while the un-excluded config demonstrably travels (26-block canopy
    // traverse). Litter is handled by the stall-breaker in executors.js
    // (it digs litter at the face) instead. See README addendum.
    bot.pathfinder.setMovements(mv);
    const p = bot.entity.position;
    log(`spawned at ${p.x.toFixed(1)},${p.y.toFixed(1)},${p.z.toFixed(1)}`);
    refreshAnchorY();
    setTimeout(canopyDescent, 6000);
    if (!greeted) {
      greeted = true;
      setTimeout(() => { try { bot.chat("Geist here — Lineage C, the Deliberator. I plan from fact files and a closed vocabulary of actions. Settling in at my anchor west of spawn."); } catch {} }, 4000);
    }
  });

  bot.on("respawn", () => setTimeout(canopyDescent, 6000));
  bot.on("chat", (user, msg) => { if (user !== OPTS.username) log(`chat <${user}> ${msg}`); });
  bot.on("death", () => {
    deaths++;
    log(`died (total ${deaths})`);
    saveProgress();
    setTimeout(() => { try { bot.respawn(); } catch {} }, 1500);
  });
  bot.on("kicked", (r) => log("kicked:", String(r)));
  bot.on("error", (e) => log("error:", e && e.message));
  bot.once("end", (r) => {
    log("connection ended:", String(r));
    spawned = false;
    relaunches++;
    if (relaunches <= 40) setTimeout(launch, Math.min(10000 * relaunches, 60000));
    else { log("too many relaunches, giving up"); process.exit(1); }
  });
}

// Canopy-descent substrate (declared; MECHANISM REPLACED 2026-11-07 — see
// README addendum): this world's spawn is a forest, and fresh players land
// ON the canopy. The original mechanism — walk forward briefly and step
// off the edge — is LETHAL at the current respawn point: on 2026-11-07
// Geist respawned in a tall canopy at y=81 and the step-off killed him
// four times in seven minutes (deaths 1-4 in the resident log: step off,
// fall ~16 blocks, die, respawn in the same canopy, repeat). A dig-down
// replacement (v2, same day) proved futile at this exact spot: the server
// runs spawn-protection=16, Geist respawns at world spawn, and a
// non-opped bot's block breaks there are cancelled — movement is not
// protected, so v3 descends by pathfinder toward the anchor instead
// (mechanism note at the call site). If we find ourselves standing on
// leaves with no solid ground within 4 blocks below, pathfind down.
// Logged as SUBSTRATE whenever it fires.
// Trigger v3.2 (2026-11-07): the firing condition is support-based
// (see the top of canopyDescent) — v3.1's elevation rule (>6 above
// the anchor's ground AND no ground within 4 below) could never
// fire at HOME: anchor ground y67 put the height gate at y73,
// Geist's respawn cell IS y73, and the forest floor ~3 below
// falsified the second clause too. The descent was disarmed by
// its own trigger geometry; the mechanism above was never the
// problem.
const CANOPY_GROUND = ["grass_block", "dirt", "stone", "sand", "gravel", "coarse_dirt", "podzol", "mycelium", "cobblestone", "bedrock", "clay", "sandstone", "dirt_path"];
let canopyBusy = false;
let lastCanopyAt = 0; // trigger v3.2 cooldown: at most one firing per 60 s
async function canopyDescent() {
  if (canopyBusy) return;
  try {
    if (!bot || !bot.entity) return;
    // Trigger v3.1 (2026-11-07): elevation-based. The name-based trigger
    // (standing on a block named *leaves) proved unreliable at the spawn
    // column: his client intermittently reads the supporting leaf block
    // as air there (the descend executor reported standingOn "air" at
    // y=81 on two fresh sessions while an observer read oak_leaves) —
    // protection-cancelled digs leave client/server block views
    // disagreeing at that cell. Ground blocks are never dug at spawn and
    // read stably, so: fire when he is >6 above the anchor's ground
    // level with no ground block within 4 below.
    // Trigger v3.2 (2026-11-07): support-based. Fire when the block he
    // is standing ON is a leaf block AND he is >2 above the anchor's
    // ground level AND that support is not itself a ground block (a
    // ground support fails the leaf test by construction; the explicit
    // check keeps the three conditions readable). The support scan
    // takes the first solid block within 3 below the feet, tolerating
    // the spawn column's flickering leaf read (v3.1's note above).
    // Cooldown 60 s: spawn/respawn timers cannot loop the firing.
    const feet = bot.entity.position.floored();
    let support = null;
    for (let d = 1; d <= 3; d++) {
      const b = bot.blockAt(feet.offset(0, -d, 0));
      if (b && b.boundingBox === "block") { support = b; break; }
    }
    if (!support) return;
    if (CANOPY_GROUND.includes(support.name)) return; // already on the floor
    if (!/_leaves$/.test(support.name)) return;       // not in a tree
    if (bot.entity.position.y <= anchor.y + 2) return; // low growth at floor level: not the canopy case
    if (Date.now() - lastCanopyAt < 60000) return;
    lastCanopyAt = Date.now();
    canopyBusy = true;
    // MECHANISM v3 (2026-11-07, same day): dig-down is FUTILE at the
    // respawn point — the Orin server runs spawn-protection=16 and Geist
    // respawns at world spawn, where a non-opped bot's block breaks are
    // cancelled by the server (measured: leaf digs below his feet on a
    // fresh session never completed; Vega's identical digs worked 19
    // blocks from spawn, outside the radius). Movement is NOT protected,
    // so descend the way Vega's verified repair does: let the pathfinder
    // walk/step down (canDig=true, maxDropDown=10) toward the anchor's
    // ground point. If no path exists it fails safely in place — never a
    // blind step off a tall canopy again.
    const gy = anchor.y;
    log("SUBSTRATE canopy-descent: elevated above anchor ground — pathfinding down toward anchor", anchor.x, gy, anchor.z);
    try {
      await Promise.race([
        bot.pathfinder.goto(new goals.GoalNear(anchor.x, gy, anchor.z, 3)),
        new Promise((_, rej) => setTimeout(() => rej(new Error("canopy descent cap 100s")), 100000)),
      ]);
      log("SUBSTRATE canopy-descent: reached anchor ground area");
    } catch (e) {
      try { bot.pathfinder.setGoal(null); } catch {}
      log("SUBSTRATE canopy-descent: pathfinder descent ended:", e.message);
    }
    if (bot && bot.entity) {
      const p = bot.entity.position;
      const un = bot.blockAt(p.offset(0, -1, 0));
      log("SUBSTRATE canopy-descent: done at", p.x.toFixed(1), p.y.toFixed(1), p.z.toFixed(1), "standingOn", un ? un.name : null);
    }
  } catch {}
  canopyBusy = false;
}

function refreshAnchorY() {
  try {
    const me = bot.entity.position;
    for (let y = Math.floor(me.y) + 18; y >= Math.floor(me.y) - 24; y--) {
      const b = bot.blockAt(new (require("vec3"))(anchor.x, y, anchor.z));
      if (b && b.boundingBox === "block") {
        if (anchor.y !== y + 1 || anchor.provisional) { anchor = { x: anchor.x, y: y + 1, z: anchor.z }; ctx.anchor = anchor; writeJson(F.anchor, anchor); log("anchor fixed:", JSON.stringify(anchor)); }
        return;
      }
    }
  } catch {}
}

// declared survival substrate: three reflexes, no deliberation. Each firing
// is logged as SUBSTRATE so the record never confuses it with a plan.
let lastSubstrate = 0;
function substrate() {
  if (!bot || !spawned || busy) return;
  const now = Date.now();
  if (bot.oxygenLevel != null && bot.oxygenLevel < 6) {
    bot.setControlState("jump", true);
    setTimeout(() => { try { bot.setControlState("jump", false); } catch {} }, 1200);
    log("SUBSTRATE: low oxygen — swimming up");
    return;
  }
  if (now - lastSubstrate < 30000) return;
  if (bot.food <= 4 && ex.FOODS.some((f) => ex.has(bot, f))) {
    lastSubstrate = now;
    log("SUBSTRATE: food critical — eating");
    ex.runAction(bot, ctx, { action: "eat", args: {} }).catch(() => {});
  }
}

// S5 continuous night watch (verdict from record, as in B's design)
function nightWatch() {
  if (!bot || !spawned) return;
  const stage = currentStage();
  if (!stage || stage.id !== "S5") { night.active = false; return; }
  const tod = bot.time.timeOfDay;
  const p = bot.entity.position;
  const centre = (ctx.shelter && ctx.shelter.centre) || anchor;
  if (tod >= 13000 && tod <= 23000) {
    if (!night.active) { night = { active: true, deaths0: deaths, midOk: null, midPos: null }; log("night watch: night begins, deaths baseline", deaths); }
    if (tod >= 17500 && tod <= 18500 && night.midOk === null) {
      night.midPos = { x: +p.x.toFixed(1), y: +p.y.toFixed(1), z: +p.z.toFixed(1) };
      night.midOk = Math.hypot(p.x - centre.x, p.z - centre.z) <= 6;
      log("night watch: mid-night position", JSON.stringify(night.midPos), "within 6 of shelter:", night.midOk);
    }
  } else if (night.active) {
    const nightDeaths = deaths - night.deaths0;
    const ok = nightDeaths === 0 && night.midOk === true;
    const evidence = { nightDeaths, midNightWithinShelter: night.midOk, midPos: night.midPos };
    const rec = stageRec("S5");
    rec.lastEvidence = evidence;
    if (ok) {
      rec.status = "pass"; rec.passedAt = new Date().toISOString();
      scoreboard("S5", "pass", evidence);
      log("STAGE S5 PASS", JSON.stringify(evidence));
    } else {
      scoreboard("S5", "fail", evidence);
      log("night watch: night failed", JSON.stringify(evidence));
    }
    saveProgress();
    night.active = false;
  }
}

