  const s = snapshot();
  if (s) {
    writeJson(F.state, s);
    for (const [k, v] of Object.entries(s.inventory)) progress.maxSeen[k] = Math.max(progress.maxSeen[k] || 0, v);
    saveProgress();
    refreshAnchorY();
  }
  substrate();
  nightWatch();
}, 10000);
setInterval(runCommandFile, 5000);
setTimeout(() => tick("first"), 75000);
setInterval(() => {
  tick("pulse").then(() => {});
}, PULSE_MS);
// after a failed tick, retry sooner than the full pulse (the on-failure
// trigger) — but never more often than ~5 minutes: the governor's mind-second
// budget is the deliberation budget, and the pulse is a pulse, not a stream.
let lastTickEnd = 0;
setInterval(() => {
  const stage = currentStage();
  if (stage && stage.id !== "S5" && !busy && Date.now() - lastTickEnd > 180000) {
    const rec = stageRec(stage.id);
    if (rec.attempts > 0 && rec.status !== "pass") tick("retry").catch(() => {});
  }
}, 300000);
