    try {
      const h = nearestHostile(bot, 16);
      rt.danger = h ? { name: h.name, dist: +h.dist.toFixed(1), at: Date.now() } : null;
      const hp = bot.health;
      const hurt = hp < lastHealth - 0.5;
      lastHealth = hp;
      if ((h && h.dist <= 8.5) || (hurt && h && h.dist <= 14)) {
