// -- shelter: the burrow reflex (2026-11-07 night; see ledger
// shelter-reflex-20261107). When running does not clear danger, a
// character DIGS IN where he stands: step to a diggable cell outside
// spawn protection, sink two blocks, seal the roof, and wait out the
// all-clear. A burrow is survival, never project progress.
function chebToSpawnXY(x, z) {
  return Math.max(Math.abs(x - 32), Math.abs(z + 96));
}
