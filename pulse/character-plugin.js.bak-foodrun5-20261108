async function eatOne(bot) {
  const items = bot.inventory.items();
  const food = EDIBLES.map((n) => items.find((i) => i.name === n)).find(Boolean);
  if (!food) return false;
  try {
    await bot.equip(food, 'hand');
    await Promise.race([bot.consume(), prims.sleep(6000)]);
    return true;
  } catch { return false; }
}
async function eatToFull(bot, target) {
  let ate = false;
  for (let i = 0; i < 4 && bot.food < target; i++) { if (await eatOne(bot)) ate = true; else break; }
  if (ate) { setIntent('Eating', 'survival', 'eat'); say(bot, "Quick bite — building's hungry work."); }
  return ate;
}
async function hunt(bot, maxDist = 26) {
  const prey = nearestPassive(bot, maxDist);
  if (!prey) return false;
  setIntent('Hunting ' + prey.name, 'survival', 'forage');
  say(bot, "Food's low — and there's a " + prey.name + ' over there. Sorry, friend.');
  log('hunt', prey.name, 'at dist', prey.dist.toFixed(1));
  const e = prey.entity;
  const t0 = Date.now();
  while (Date.now() - t0 < 30000 && e && e.isValid && e.position) {
    guard();
    const d = e.position.distanceTo(bot.entity.position);
    if (d > 2.1) { await prims.gotoNear(bot, e.position.x, e.position.y, e.position.z, 1.4, 5000); }
    else {
      try { await bot.lookAt(e.position.offset(0, 0.6, 0), true); } catch {}
      try { bot.attack(e); } catch {}
      await prims.sleep(550);
    }
  }
  await prims.collectDrops(bot, 7, 6000);
  return true;
}

