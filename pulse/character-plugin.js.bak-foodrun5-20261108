          const g = await prims.gotoNear(bot, TORCH_REF.x, TORCH_REF.y, TORCH_REF.z, 2.8, 30000);
          if (!g.ok) return;
          const r = await prims.placeAgainst(bot, 'torch', TORCH_REF, new Vec3(0, 0, 1));
          log('torch place ->', JSON.stringify(r), 'now', blockNameAt(bot, 64, 68, -94));
          if (r.ok) say(bot, "Torch up. Light in the house — much better.");
          return;
        }
        if (!prims.hasItem(bot, 'charcoal') && !prims.hasItem(bot, 'coal')) {
          const furnacePlaced = blockNameAt(bot, FURNACE_POS.x, FURNACE_POS.y, FURNACE_POS.z) === 'furnace';
          if (!furnacePlaced) {
            if (!prims.hasItem(bot, 'furnace')) {
              if ((prims.countItem(bot, 'cobblestone') || 0) < 8) {
                setIntent('Quarrying stone', 'hut', 'quarry');
                say(bot, 'Need stone for a furnace — digging a little quarry by the pad.');
                for (const q of QUARRY) {
                  const c = columnTop(bot, q.x, q.z);
                  if (c && c.top > q.top) { await prims.digBlock(bot, new Vec3(q.x, c.top, q.z), 20000); return; }
                }
                const faces = [[71, 64, -93], [71, 63, -93], [71, 62, -93], [70, 62, -93], [69, 62, -93]];
                for (const [fx, fy, fz] of faces) {
                  const n = blockNameAt(bot, fx, fy, fz);
                  if (n && (n === 'stone' || /_ore$/.test(n))) { await prims.digBlock(bot, new Vec3(fx, fy, fz), 20000); return; }
                }
                log('quarry: no diggable face found');
                return;
              }
              const g = await prims.gotoNear(bot, TABLE_POS.x, TABLE_POS.y, TABLE_POS.z, 2.6, 30000);
              if (!g.ok) return;
              const r = await prims.craftByName(bot, 'furnace', 1, TABLE_POS);
              log('craft furnace ->', JSON.stringify(r));
              return;
            }
            const g = await prims.gotoNear(bot, FURNACE_POS.x, FURNACE_POS.y, FURNACE_POS.z, 2.6, 30000);
            if (!g.ok) return;
            const r = await prims.placeOnTop(bot, 'furnace', new Vec3(FURNACE_POS.x, FURNACE_POS.y - 1, FURNACE_POS.z));
            log('place furnace ->', JSON.stringify(r));
            return;
          }
          if (logCount(bot) < 1 || plankCount(bot) < 1) { await ensureLogs(bot, 2); return; }
          await smeltCharcoal(bot);
          return;
        }
        if (!prims.hasItem(bot, 'stick', 1)) {
          const t = await ensurePlankType(bot, 2);
          if (t) await prims.craftByName(bot, 'stick', 1);
          return;
        }
        const r = await prims.craftByName(bot, 'torch', 1);
        log('craft torch ->', JSON.stringify(r));
        return;
      }
      log('hut work: no sub-step fired; scan', JSON.stringify(scan));
    },
  },
  {
    id: 'chest', title: 'A chest and stored surplus',
    done(bot) {
      const n = blockNameAt(bot, CHEST_POS.x, CHEST_POS.y, CHEST_POS.z);
      if (n !== 'chest') return false;
      return rt.S.milestones.chest === true; // contents verified in work()
    },
    async work(bot) {
      setIntent('Setting up storage', 'chest', 'store');
      const placed = blockNameAt(bot, CHEST_POS.x, CHEST_POS.y, CHEST_POS.z) === 'chest';
      if (!placed) {
        if (!prims.hasItem(bot, 'chest')) {
          const t = await ensurePlankType(bot, 8);
          if (!t || dominantPlank(bot).count < 8) { await ensureLogs(bot, 3); return; }
          const g = await prims.gotoNear(bot, TABLE_POS.x, TABLE_POS.y, TABLE_POS.z, 2.6, 30000);
          if (!g.ok) return;
          const r = await prims.craftByName(bot, 'chest', 1, TABLE_POS);
          log('craft chest ->', JSON.stringify(r));
          return;
        }
        const g = await prims.gotoNear(bot, CHEST_POS.x, CHEST_POS.y, CHEST_POS.z, 2.6, 30000);
        if (!g.ok) return;
        const r = await prims.placeOnTop(bot, 'chest', new Vec3(CHEST_POS.x, CHEST_POS.y - 1, CHEST_POS.z));
        log('place chest ->', JSON.stringify(r));
        return;
      }
      // Deposit surplus; keep tools, food, sticks and the working plank stack.
      const keep = ['wooden_pickaxe', 'stone_pickaxe', 'wooden_axe', 'stone_axe', 'stick', 'torch', 'oak_door', 'birch_door'];
      const dom = dominantPlank(bot);
      if (dom.name) keep.push(dom.name);
      for (const e of EDIBLES) keep.push(e);
      const g = await prims.gotoNear(bot, CHEST_POS.x, CHEST_POS.y, CHEST_POS.z, 2.6, 30000);
      if (!g.ok) return;
      const before = await prims.openChestContents(bot, CHEST_POS);
      const dep = await prims.depositInChest(bot, CHEST_POS, keep);
      const after = await prims.openChestContents(bot, CHEST_POS);
      log('deposit ->', JSON.stringify(dep).slice(0, 200), 'chest total now', after.ok ? after.total : '?');
      if (after.ok && after.total >= 3) {
        rt.S.milestones.chest = true;
        say(bot, "Chest's in and the surplus is stored. Tools stay on me.");
      }
    },
  },
  {
    id: 'pen', title: 'A fenced pen',
    done(bot) {
      let n = 0;
      for (const c of PEN_CELLS) {
        const top = columnTop(bot, c.x, c.z);
        if (!top) continue;
        const nm = blockNameAt(bot, c.x, top.top + 1, c.z);
        if (nm && /_fence$/.test(nm)) n++;
      }
      return n >= 10;
    },
    async work(bot) {
      setIntent('Fencing a pen', 'pen', 'fence');
      say(bot, 'Fencing a little pen by the house.');
      if (!prims.hasItem(bot, 'oak_fence') && !prims.hasItem(bot, 'birch_fence')) {
        const t = await ensurePlankType(bot, 4);
        if (!t) { await ensureLogs(bot, 2); return; }
        if (!prims.hasItem(bot, 'stick', 2)) { await prims.craftByName(bot, 'stick', 1); return; }
        if (dominantPlank(bot).count < 4) { await ensureLogs(bot, 2); return; }
        const g = await prims.gotoNear(bot, TABLE_POS.x, TABLE_POS.y, TABLE_POS.z, 2.6, 30000);
        if (!g.ok) return;
        const fenceName = t.replace('_planks', '_fence');
        const r = await prims.craftByName(bot, fenceName, 1, TABLE_POS);
        log('craft fence ->', JSON.stringify(r));
        return;
      }
      const fenceItem = prims.hasItem(bot, 'oak_fence') ? 'oak_fence' : 'birch_fence';
      for (const c of PEN_CELLS) {
        const top = columnTop(bot, c.x, c.z);
        if (!top) continue;
        const nm = blockNameAt(bot, c.x, top.top + 1, c.z);
        if (nm && /_fence$/.test(nm)) continue;
        const g = await prims.gotoNear(bot, c.x, top.top + 1, c.z, 2.4, 30000);
        if (!g.ok) return;
        const r = await prims.placeOnTop(bot, fenceItem, new Vec3(c.x, top.top, c.z));
        log('fence place', c.x, c.z, JSON.stringify(r));
        return;
      }
    },
  },
);

// ── the day loop ─────────────────────────────────────────────────────
const PROJECT_LINES = {
  relocate: 'Moving to my homestead',
  pickaxe: 'First tool: a wooden pickaxe',
  pad: 'Levelling the building pad',
  hut: 'Building the starter hut',
  chest: 'Setting up storage',
  pen: 'Fencing the pen',
};
async function idleAtHome(bot) {
  setIntent('Living at the homestead', 'homestead', 'idle');
  const a = (Math.random() * Math.PI * 2);
  const r = 2 + Math.random() * 2;
  await prims.gotoNear(bot, HOME.x + Math.cos(a) * r, HOME.y, HOME.z + Math.sin(a) * r, 1.2, 20000);
  await prims.sleep(20000 + Math.random() * 20000);
}
async function dayLoop(bot, gen) {
  rt.S = loadS();
  rt.bootAt = Date.now();
  say(bot, "Morning. Right — new plan. I'm building a home out east, and I'm going to live in it.");
  log('day loop started; milestones so far', JSON.stringify(rt.S.milestones));
  let diedLastCheck = false;
  while (gen === rt.gen && bot.entity) {
    try {
      if (global.__pulseRunnerActive) { await prims.sleep(5000); continue; } // a trial owns the body
      if (bot.health <= 0) { await prims.sleep(3000); continue; }
      // Respawn detection: popped back at spawn with empty hands.
      const atSpawn = chebToSpawn(bot) <= 3;
      if (atSpawn && !diedLastCheck && rt.bootAt && Date.now() - rt.bootAt > 60000) {
        say(bot, "I'm back. Heading home to pick up where I left off.", true);
      }
      diedLastCheck = atSpawn;
      // Danger first. If running does not clear it — or he has just
      // died into danger (respawn lands in the same saturation) — he
      // DIGS IN (shelter reflex, 2026-11-07): survival outranks every
      // project, and home means nothing while the road kills him.
      if (rt.danger && rt.danger.dist <= 12) {
        const cleared = await flee(bot);
        if (!cleared && !hutScan(bot).complete) { await shelter(bot); }
        else if (rt.diedRecently && bot.health < 20 && nearestHostile(bot, 20)) { await shelter(bot); }
        writeCharState(bot); continue;
      }
      // Food: eat what he carries (target 19 when hurt - regen needs
      // a near-full bar); forage when it's urgent. Health-critical
      // hunger outranks project work entirely (food run, 2026-11-08).
      if (bot.health < 4 && bot.food < 18) {
        const fed = await criticalForage(bot);
        writeCharState(bot);
        if (fed) continue;
        log('CRITICAL FORAGE v4: unfed - falling through to projects; relocate home is the food route');
      }
      if (bot.food <= 14 || (bot.health < 20 && bot.food <= 17)) { await eatToFull(bot, 19); }
      if (bot.food <= 8 && !prims.inv(bot).hasOwnProperty) { /* noop guard */ }
      if (bot.food <= 8) {
        const hasFood = EDIBLES.some((n) => prims.hasItem(bot, n));
        if (!hasFood) {
          try { await hunt(bot); } catch (e) { if (e instanceof Interrupt) { await flee(bot); continue; } throw e; }
          await eatToFull(bot, 16);
        }
      }
      // Pick the project to work: canonically the first whose
      // evidence does not hold yet. The actor may re-rank the open
      // list within bounds (relocate, while open, is never re-ranked
      // away; done projects are never picked); template order is
      // the fallback whenever the actor is off or silent.
      const openList = [];
      for (const p of PROJECTS) {
        let d = false;
        try { d = p.done(bot); } catch (e) { d = false; }
        if (d && !rt.knownDone.has(p.id)) {
          rt.knownDone.add(p.id);
          if (!rt.S.milestones[p.id]) {
            rt.S.milestones[p.id] = nowIso();
            ledger({ ts: nowIso(), kind: 'character-milestone', id: 'character-' + p.id + '-done', what: 'Character project completed (live world-evidence predicate first held): ' + p.id + ' — ' + p.title, class: 'character' });
            log('PROJECT COMPLETE:', p.id);
            if (actor) { try { actor.fileProjectComplete(p.id, p.title, buildActorContext(bot)); } catch {} }
          }
        }
        if (!d) openList.push(p);
      }
      writeCharState(bot);
      if (!openList.length) { await idleAtHome(bot); continue; }
      let proj = openList[0];
      if (actor && proj.id !== 'relocate') {
        const rank = actor.getRank();
        if (rank) for (const id of rank) { const cand = openList.find((p) => p.id === id); if (cand) { proj = cand; break; } }
      }
      // Stuck detection (the actor's library-consult hook): the same
      // project selected for 10+ minutes inside a 3-block box with
      // no milestone -> file one consult per stuck episode.
      if (bot.entity) {
        const pp = bot.entity.position;
        if (!rt.stuckTrack || rt.stuckTrack.project !== proj.id) {
          rt.stuckTrack = { project: proj.id, since: Date.now(), x: pp.x, z: pp.z, filed: false };
        } else {
          const st = rt.stuckTrack;
          if (Math.hypot(pp.x - st.x, pp.z - st.z) > 3) { st.x = pp.x; st.z = pp.z; st.since = Date.now(); st.filed = false; }
          else if (!st.filed && Date.now() - st.since > 600000) {
            st.filed = true;
            log('STUCK on', proj.id, 'for 10+ min in a 3-block box — filing library consult');
            if (actor) { try { actor.fileStuck(proj.id, proj.title, buildActorContext(bot)); } catch {} }
          }
        }
      }
      currentProjectId = proj.id;
      setIntent(PROJECT_LINES[proj.id] || proj.title, proj.id, 'work');
      try {
        await proj.work(bot);
      } catch (e) {
        if (e instanceof Interrupt) { await flee(bot); }
        else { log('project', proj.id, 'work error:', e.message); await prims.sleep(3000); }
      }
      writeCharState(bot);
      await prims.sleep(1200);
    } catch (e) {
      log('day loop iteration error:', e && e.message);
      await prims.sleep(4000);
    }
  }
  log('day loop exiting (gen', gen, ')');
}

// ── actor context (what the System-2 actor sees each beat) ──────────
function buildActorContext(bot) {
  const cc = global.__codyCharacter || {};
  const p = bot && bot.entity ? bot.entity.position : { x: 0, y: 0, z: 0 };
  const open = [];
  for (const pr of PROJECTS) {
    let d = false;
    try { d = pr.done(bot); } catch (e) { d = false; }
    if (!d) open.push({ id: pr.id, title: pr.title });
  }
  return {
    intent: cc.intent || null,
    project: cc.project || currentProjectId,
    step: cc.step || null,
    pos: { x: +p.x.toFixed(1), y: +p.y.toFixed(1), z: +p.z.toFixed(1) },
    health: bot ? bot.health : null,
    food: bot ? bot.food : null,
    inventory: bot ? prims.inv(bot) : {},
    openProjects: open,
    milestones: rt.S ? Object.keys(rt.S.milestones) : [],
  };
}

// ── wiring (framework plugin idiom, same shape as pulse-plugin) ─────
function wire(bot) {
  if (!bot || rt.wired.has(bot)) return;
  rt.wired.add(bot);
  rt.gen++;
  const gen = rt.gen;
  global.__codyCharacterActive = true;
  setIntent('Waking up', 'boot', 'spawn');
  bot.on('death', () => {
    rt.diedRecently = true; rt.burrowed = false;
    if (rt.S) { rt.S.deathsSeen++; }
    if (actor) actor.noteEvent('death');
    log('death noticed by character loop');
  });
  const start = () => {
    if (gen !== rt.gen || !bot.entity) return;
    startMonitor(bot, gen);
    if (actor) {
      try {
        actor.start(bot, {
          sayDirect: (line) => say(bot, line, false, true),
          lastChatAt: () => rt.lastChatAt,
          context: () => buildActorContext(bot),
          ledger,
        });
      } catch (e) { log('actor start failed:', e.message); }
    }
    setInterval(() => { if (gen === rt.gen) writeCharState(bot); }, 15000);
    setTimeout(() => { dayLoop(bot, gen).catch((e) => log('day loop crashed:', e.message)); }, 6000);
    log('character loop armed (gen', gen, ')');
  };
  if (bot.entity) start();
  bot.once('spawn', start);
}

module.exports = {
  name: 'character',
  version: '1.0.0',
  description: 'Cody as a character: goal-directed day loop (homestead build), survival behaviour, self-narration',
  init(ctx) {
    const b = (ctx && ctx.bot) || (ctx && ctx.entity !== undefined ? ctx : null);
    if (b) wire(b);
  },
  wire,
};
