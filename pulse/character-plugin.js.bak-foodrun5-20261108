async function shelterHold(bot, sealed) {
  // Hold until 60 continuous seconds with no hostile within 16, cap
  // 10 min. Eat for regen while waiting. Returns true if he held.
  let clearSince = null;
  const t0 = Date.now();
  while (Date.now() - t0 < 600000 && bot.entity && bot.health > 0) {
    const h = nearestHostile(bot, 16);
    if (!h) { if (!clearSince) clearSince = Date.now(); if (Date.now() - clearSince >= 60000) break; }
    else clearSince = null;
    if (bot.food <= 17) { try { await eatToFull(bot, 19); } catch {} }
    writeCharState(bot);
    await prims.sleep(5000);
  }
  log('SHELTER: hold over; danger now', JSON.stringify(nearestHostile(bot, 16)), 'sealed was', sealed);
  rt.diedRecently = false;
  return true;
}

