function sealMaterial(bot) {
  const prefs = ['oak_planks', 'birch_planks', 'spruce_planks', 'cobblestone', 'dirt', 'oak_log', 'birch_log'];
  const inv = prims.inv(bot);
  for (const n of prefs) if (inv[n] > 0) return n;
  const any = Object.keys(inv).find((n) => /planks|cobble|dirt|log|stone/.test(n) && inv[n] > 0);
  return any || null;
}
async function shelter(bot) {
