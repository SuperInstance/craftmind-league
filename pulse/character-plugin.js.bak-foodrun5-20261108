  say(bot, 'Too hot out here. Digging in till it clears.');
  log('SHELTER: burrow reflex engaged at', JSON.stringify(bot.entity.position));
  try {
    const p = bot.entity.position;
    const fx = Math.floor(p.x), fz = Math.floor(p.z);
    // Site choice: outward rings from where he stands; prefer a cell
    // OUTSIDE spawn protection (digs inside it are server-cancelled),
    // with diggable ground and air at feet/head.
    let site = null;
    const offs = [[0,0],[2,0],[-2,0],[0,2],[0,-2],[4,0],[-4,0],[0,4],[0,-4],[6,0],[-6,0],[0,6],[0,-6],[3,3],[-3,3],[3,-3],[-3,-3],[8,0],[0,8],[-8,0],[0,-8]];
    for (const [dx, dz] of offs) {
      const cx = fx + dx, cz = fz + dz;
      const top = columnTop(bot, cx, cz);
      if (!top || isAirName(top.name)) continue;
      if (!/dirt|grass|stone|sand|gravel|planks|log/.test(top.name)) continue;
      const outside = chebToSpawnXY(cx, cz) > 17;
      if (!site || (outside && !site.outside)) site = { x: cx, z: cz, topY: top.top, outside };
      if (outside) break;
    }
    if (!site) { log('SHELTER: no diggable site found — degrading to hold'); return await shelterHold(bot, false); }
    if (site.x !== fx || site.z !== fz) {
      const g = await prims.gotoNear(bot, site.x + 0.5, site.topY + 1, site.z + 0.5, 1.2, 12000);
      if (!g.ok) log('SHELTER: could not reach site', site.x, site.z, '— digging where he stands');
    }
