        if (dw > dNow - 0.5) continue;
        if (rt.legSkip[rt.routeIdx + ':' + i] && Date.now() - rt.legSkip[rt.routeIdx + ':' + i] < 90000) continue;
        const db = Math.hypot(w.x - p.x, w.z - p.z);
        // v1.3.1: a hop he is already standing on (inside the gotoNear
