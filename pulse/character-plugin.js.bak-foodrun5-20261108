  const cands = [];
  for (const e of Object.values(bot.entities || {})) {
    if (!e || !e.position || !PASSIVES.has(e.name)) continue;
    const d = e.position.distanceTo(bot.entity.position);
    if (d > 40) continue;
    if (rt.forageBlocked.some((b) => Math.hypot(e.position.x - b.x, e.position.z - b.z) < 6)) continue;
    cands.push({ entity: e, name: e.name, dist: d, pos: e.position });
  }
  if (!cands.length) return null;
  cands.sort((a, b) => a.dist - b.dist);
  const meaty = cands.filter((c) => c.name !== 'chicken' && c.name !== 'rabbit');
  return meaty.length ? meaty[0] : cands[0];
}

async function appleTree(bot) {
