  await prims.digColumn(bot, target, 8);
  try {
    const leaves = prims.findBlocks(bot, ['oak_leaves'], 7, 12);
    for (const lp of leaves.slice(0, 10)) { guard(); await prims.digBlock(bot, lp, 8000); }
  } catch (e) { if (e instanceof Interrupt) throw e; }
  await prims.collectDrops(bot, 8, 7000);
  return true;
}

async function criticalForage(bot) {
  if (!(bot.health < 4 && bot.food < 18)) return false;
  setIntent('Finding food - health critical', 'survival', 'critical-forage');
  say(bot, 'I am hurt and hungry. Food first, building second.', true);
  log('CRITICAL FORAGE v2: hp', bot.health, 'food', bot.food, 'inv', JSON.stringify(prims.inv(bot)));
  await eatToFull(bot, 19);
  if (rt.lastForageFailAt && Date.now() - rt.lastForageFailAt < 90000) {
    const quick = await nearestCriticalPrey(bot);
    if (!quick || quick.dist > 20) { log('CRITICAL FORAGE v4: fast-fail - recent attempts, nothing close'); return false; }
  }
  // Work from home ground: the v1 run ranged 45 blocks south-east and
  // wedged on a step face under an unreachable chicken. Food work is
  // local now - prey must live within 32 of the anchor, failed prey are
  // remembered and skipped, and the canopy at home is the fallback.
  if (distHome(bot) > 6) {
    const g = await prims.gotoNear(bot, HOME.x, HOME.y, HOME.z, 2.5, 30000);
    log('CRITICAL FORAGE v2: return-home ->', JSON.stringify(g).slice(0, 120));
  }
  for (let attempt = 0; attempt < 4 && bot.food < 18; attempt++) {
    guard();
    const foodBefore = bot.food;
    const prey = await nearestCriticalPrey(bot);
    if (prey) {
      log('CRITICAL FORAGE v2: prey', prey.name, 'dist', prey.dist.toFixed(1));
      // Close on the chosen prey first so hunt() picks it too.
      try { await prims.gotoNear(bot, prey.pos.x, prey.pos.y, prey.pos.z, 6, 12000); } catch {}
      let acted = false;
      try { acted = await hunt(bot, 30); } catch (e) { if (e instanceof Interrupt) throw e; log('CRITICAL FORAGE v2: hunt failed', e.message); }
      await prims.collectDrops(bot, 8, 5000).catch(() => {});
      await eatToFull(bot, 19);
      if (bot.food <= foodBefore && !EDIBLES.some((n) => prims.hasItem(bot, n))) {
        rt.forageBlocked.push({ x: prey.pos.x, z: prey.pos.z, at: Date.now() });
        log('CRITICAL FORAGE v2: prey yielded nothing; blocked', prey.name, 'at', Math.round(prey.pos.x), Math.round(prey.pos.z));
      }
      if (acted) continue;
    }
    log('CRITICAL FORAGE v3: canopy fallback - oak first (apples), else any tree');
    try {
      const oak = await appleTree(bot);
      if (!oak) await fellTree(bot);
    } catch (e) { if (e instanceof Interrupt) throw e; log('CRITICAL FORAGE v3: canopy failed', e.message); }
    await prims.collectDrops(bot, 8, 5000).catch(() => {});
    await eatToFull(bot, 19);
  }
  if (bot.food >= 18) {
    setIntent('Recovering - food first', 'survival', 'recover');
    const t0 = Date.now();
    while (bot.health > 0 && bot.health < 10 && Date.now() - t0 < 600000) {
      if (rt.danger && rt.danger.dist <= 12) throw new Interrupt('danger:' + rt.danger.name);
      if (bot.food <= 17) { await eatToFull(bot, 19); if (bot.food < 18) break; }
      writeCharState(bot);
      await prims.sleep(5000);
    }
    log('CRITICAL FORAGE v2: recovery hold ended hp', bot.health, 'food', bot.food);
    return true;
  }
  rt.lastForageFailAt = Date.now();
  log('CRITICAL FORAGE v2: still no food; hp', bot.health, 'food', bot.food, 'inv', JSON.stringify(prims.inv(bot)));
  return false;
}

// ── wood & crafting helpers ──────────────────────────────────────────
function logCount(bot) {
  const inv = prims.inv(bot);
  return Object.keys(inv).filter((n) => LOG_RE.test(n)).reduce((a, n) => a + inv[n], 0);
}
function plankCount(bot) {
  const inv = prims.inv(bot);
  return Object.keys(inv).filter((n) => PLANK_RE.test(n)).reduce((a, n) => a + inv[n], 0);
}
function dominantPlank(bot) {
  const inv = prims.inv(bot);
  let best = null, bn = 0;
  for (const n of Object.keys(inv)) if (PLANK_RE.test(n) && inv[n] > bn) { best = n; bn = inv[n]; }
  return { name: best, count: bn };
}
async function fellTree(bot) {
  const names = Object.keys(prims.mcData(bot).blocksByName).filter((n) => LOG_RE.test(n));
  const found = prims.findBlocks(bot, names, 44, 8);
  if (!found.length) { log('fellTree: no tree within 44'); return false; }
  // Prefer the column whose base is closest to ground level near us.
  const target = found[0];
  setIntent('Felling a tree', currentProjectId, 'gather-wood');
  say(bot, 'Timber! Gathering wood.');
  log('felling column at', target.x, target.y, target.z);
  const before = logCount(bot);
  const r = await prims.digColumn(bot, target, 8);
  log('digColumn ->', JSON.stringify(r));
  // Canopy: knock a few leaves loose for apples/saplings, then sweep drops.
  try {
    const leaves = prims.findBlocks(bot, ['oak_leaves', 'birch_leaves', 'spruce_leaves'], 7, 10);
    for (const lp of leaves.slice(0, 8)) { guard(); await prims.digBlock(bot, lp, 8000); }
  } catch (e) { if (e instanceof Interrupt) throw e; }
  await prims.collectDrops(bot, 8, 7000);
  return logCount(bot) > before || r.ok;
}
// Convert logs until the dominant single plank type reaches `need`
// (recipes for table/door/chest/pickaxe are single-type). Returns the
// dominant plank name or null.
async function ensurePlankType(bot, need) {
  for (let i = 0; i < 10; i++) {
    guard();
    const dom = dominantPlank(bot);
    if (dom.name && dom.count >= need) return dom.name;
    // Convert a log of the dominant species, else any log.
    const inv = prims.inv(bot);
    const species = dom.name ? dom.name.replace('_planks', '') : null;
    const logName = (species && inv[species + '_log'] > 0) ? species + '_log'
      : Object.keys(inv).find((n) => LOG_RE.test(n) && inv[n] > 0);
    if (!logName) return dom.name; // out of logs; caller gathers more
    const plankName = logName.replace('_log', '_planks');
    const r = await prims.craftByName(bot, plankName, 1);
    if (!r.ok) { log('plank craft failed:', r.error); return dom.name; }
  }
  const dom = dominantPlank(bot);
  return dom.name;
}
async function ensureLogs(bot, n) {
  let tries = 0;
  while (logCount(bot) < n && tries < 5) {
    guard();
    const ok = await fellTree(bot);
    if (!ok) { await prims.sleep(3000); }
    tries++;
  }
  return logCount(bot) >= n;
}

