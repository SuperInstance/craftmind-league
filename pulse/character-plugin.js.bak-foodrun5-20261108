    // is unreliable mid-fall/mid-slide). Verified by the world itself
    // afterwards (phantom-dig detection: the block must CHANGE).
    await prims.sleep(600);
    const bp = bot.entity.position;
    const bx = Math.floor(bp.x), bz = Math.floor(bp.z);
    const ct = columnTop(bot, bx, bz);
    if (!ct || isAirName(ct.name)) { log('SHELTER: no column top to dig — degraded hold'); return await shelterHold(bot, false); }
    const r1 = await prims.digBlock(bot, new Vec3(bx, ct.top, bz), 12000);
    const afterB = bot.blockAt(new Vec3(bx, ct.top, bz));
    if (!r1.ok || (afterB && afterB.name === ct.name)) {
      log('SHELTER: dig refused/phantom at', bx, ct.top, bz, '(protection?) — degraded hold');
      return await shelterHold(bot, false);
    }
    // He drops into the first hole; dig the second level from inside:
    // again by survey — the new column top under his feet.
    await prims.sleep(900);
    const p2 = bot.entity.position;
    const ct2 = columnTop(bot, Math.floor(p2.x), Math.floor(p2.z));
    if (ct2) await prims.digBlock(bot, new Vec3(Math.floor(p2.x), ct2.top, Math.floor(p2.z)), 12000);
    await prims.sleep(900);
    // Seal the roof two above the floor he stands on.
    const p3 = bot.entity.position;
