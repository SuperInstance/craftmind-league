// ── world reading ────────────────────────────────────────────────────
// Column profile: highest solid (boundingBox 'block', leaves excluded)
// plus any leaf_litter cap above it. Mirrors the prep-survey convention.
function columnTop(bot, x, z) {
  if (!bot.entity) return null;
  const yTop = Math.min(250, Math.floor(bot.entity.position.y) + 24);
  const yBot = Math.floor(bot.entity.position.y) - 32;
  let top = null, name = null, litterY = null;
  for (let y = yTop; y > yBot; y--) {
    const b = bot.blockAt(new Vec3(x, y, z));
    if (!b) continue;
    if (b.name === 'leaf_litter' && litterY === null && top === null) litterY = y;
    if (b.boundingBox === 'block' && !/_leaves$/.test(b.name)) { top = y; name = b.name; break; }
  }
  if (top === null) return null;
  return { top, name, litterY };
}
function spawnPoint(bot) {
  return bot.spawnPoint ? { x: bot.spawnPoint.x, z: bot.spawnPoint.z } : { x: 32, z: -96 };
}
function chebToSpawn(bot) {
  const s = spawnPoint(bot); const p = bot.entity.position;
  return Math.max(Math.abs(p.x - s.x), Math.abs(p.z - s.z));
}
function distHome(bot) {
  const p = bot.entity.position;
  return Math.hypot(p.x - HOME.x, p.z - HOME.z);
}
function nearestHostile(bot, maxDist) {
  if (!bot.entity) return null;
  let best = null;
  for (const e of Object.values(bot.entities || {})) {
    if (!e || !e.position || !HOSTILES.has(e.name)) continue;
    const d = e.position.distanceTo(bot.entity.position);
    if (d <= maxDist && (!best || d < best.dist)) best = { name: e.name, dist: d, pos: e.position };
  }
  return best;
}
function nearestPassive(bot, maxDist) {
  if (!bot.entity) return null;
  let best = null;
  for (const e of Object.values(bot.entities || {})) {
    if (!e || !e.position || !PASSIVES.has(e.name)) continue;
    const d = e.position.distanceTo(bot.entity.position);
    if (d <= maxDist && (!best || d < best.dist)) best = { entity: e, name: e.name, dist: d };
  }
  return best;
}

