function wallCells(level) { // level 67 or 68; door gap at (62,-93)
  const cells = [];
  for (let x = PAD.x0; x <= PAD.x1; x++) { cells.push({ x, z: PAD.z0 }); cells.push({ x, z: PAD.z1 }); }
  for (let z = PAD.z0 + 1; z <= PAD.z1 - 1; z++) { cells.push({ x: PAD.x0, z }); cells.push({ x: PAD.x1, z }); }
  return cells.filter((c) => !(c.x === 62 && c.z === -93)).map((c) => ({ x: c.x, y: level, z: c.z }));
}
function blockNameAt(bot, x, y, z) {
  const b = bot.blockAt(new Vec3(x, y, z));
  return b ? b.name : null;
}
function isPlankAt(bot, x, y, z) { const n = blockNameAt(bot, x, y, z); return !!n && PLANK_RE.test(n); }
function hutScan(bot) {
  const walls67 = wallCells(67).every((c) => isPlankAt(bot, c.x, c.y, c.z));
  const walls68 = wallCells(68).every((c) => isPlankAt(bot, c.x, c.y, c.z));
  let roof = true;
  for (let x = PAD.x0; x <= PAD.x1; x++) for (let z = PAD.z0; z <= PAD.z1; z++) {
    const n = blockNameAt(bot, x, 69, z);
    if (!n || n === 'air') roof = false;
  }
  const door = blockNameAt(bot, 62, 67, -93) === 'oak_door' || blockNameAt(bot, 62, 67, -93) === 'birch_door';
  const torchN = blockNameAt(bot, 64, 68, -94);
  const torch = torchN === 'wall_torch' || torchN === 'torch';
  return { walls67, walls68, roof, door, torch, complete: walls67 && walls68 && roof && torch };
}
async function ensureBuildPlanks(bot, n) {
  if (plankCount(bot) >= n) return true;
  const needLogs = Math.ceil((n - plankCount(bot)) / 4) + 1;
  if (logCount(bot) < needLogs) { await ensureLogs(bot, needLogs); }
  for (let i = 0; i < 8 && plankCount(bot) < n; i++) {
    guard();
    const inv = prims.inv(bot);
    const logName = Object.keys(inv).find((nm) => LOG_RE.test(nm) && inv[nm] > 0);
    if (!logName) break;
    await prims.craftByName(bot, logName.replace('_log', '_planks'), 1);
  }
  return plankCount(bot) >= n;
}
async function smeltCharcoal(bot) {
  const g = await prims.gotoNear(bot, FURNACE_POS.x, FURNACE_POS.y, FURNACE_POS.z, 2.6, 30000);
  if (!g.ok) return false;
  const fb = bot.blockAt(FURNACE_POS);
  if (!fb || fb.name !== 'furnace') return false;
  const data = prims.mcData(bot);
  const inv = prims.inv(bot);
  const logName = Object.keys(inv).find((n) => LOG_RE.test(n) && inv[n] > 0);
  const plankName = Object.keys(inv).find((n) => PLANK_RE.test(n) && inv[n] > 0);
  if (!logName || !plankName) return false;
  let furnace;
  try {
    furnace = await bot.openFurnace(fb);
    await furnace.putInput(data.itemsByName[logName].id, null, 1);
    await furnace.putFuel(data.itemsByName[plankName].id, null, 1);
    const t0 = Date.now();
    let got = false;
    while (Date.now() - t0 < 40000) {
      guard();
      const out = furnace.outputItem();
      if (out && out.name === 'charcoal') { await furnace.takeOutput(); got = true; break; }
      await prims.sleep(1000);
    }
    try { furnace.close(); } catch {}
    log('smelt charcoal ->', got);
    return got;
  } catch (e) {
    try { if (furnace) furnace.close(); } catch {}
    log('smelt failed:', e.message);
    return false;
  }
}

