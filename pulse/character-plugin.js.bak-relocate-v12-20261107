// ── world reading ────────────────────────────────────────────────────
// Column profile: highest solid (boundingBox 'block', leaves excluded)
// plus any leaf_litter cap above it. Mirrors the prep-survey convention.
function columnTop(bot, x, z) {
  if (!bot.entity) return null;
  const yTop = Math.min(250, Math.floor(bot.entity.position.y) + 24);
  const yBot = Math.floor(bot.entity.position.y) - 32;
  let top = null, name = null, litterY = null;
  for (let y = yTop; y > yBot; y--) {
    const b = bot.blockAt(new Vec3(x, y, z));
    if (!b) continue;
    if (b.name === 'leaf_litter' && litterY === null && top === null) litterY = y;
    if (b.boundingBox === 'block' && !/_leaves$/.test(b.name)) { top = y; name = b.name; break; }
  }
  if (top === null) return null;
  return { top, name, litterY };
}
function spawnPoint(bot) {
  return bot.spawnPoint ? { x: bot.spawnPoint.x, z: bot.spawnPoint.z } : { x: 32, z: -96 };
}
function chebToSpawn(bot) {
  const s = spawnPoint(bot); const p = bot.entity.position;
  return Math.max(Math.abs(p.x - s.x), Math.abs(p.z - s.z));
}
function distHome(bot) {
  const p = bot.entity.position;
  return Math.hypot(p.x - HOME.x, p.z - HOME.z);
}
function nearestHostile(bot, maxDist) {
  if (!bot.entity) return null;
  let best = null;
  for (const e of Object.values(bot.entities || {})) {
    if (!e || !e.position || !HOSTILES.has(e.name)) continue;
    const d = e.position.distanceTo(bot.entity.position);
    if (d <= maxDist && (!best || d < best.dist)) best = { name: e.name, dist: d, pos: e.position };
  }
  return best;
}
function nearestPassive(bot, maxDist) {
  if (!bot.entity) return null;
  let best = null;
  for (const e of Object.values(bot.entities || {})) {
    if (!e || !e.position || !PASSIVES.has(e.name)) continue;
    const d = e.position.distanceTo(bot.entity.position);
    if (d <= maxDist && (!best || d < best.dist)) best = { entity: e, name: e.name, dist: d };
  }
  return best;
}

// ── survival monitor (body behaviour) ────────────────────────────────
function startMonitor(bot, gen) {
  let lastHealth = 20;
  const iv = setInterval(() => {
    if (gen !== rt.gen || !bot.entity) return;
    try {
      const h = nearestHostile(bot, 16);
      rt.danger = h ? { name: h.name, dist: +h.dist.toFixed(1), at: Date.now() } : null;
      const hp = bot.health;
      const hurt = hp < lastHealth - 0.5;
      lastHealth = hp;
      if ((h && h.dist <= 8.5) || (hurt && h && h.dist <= 14)) {
        // Imminent contact: cancel whatever the body is doing NOW.
        // The work loop sees rt.danger at its next guard() and flees.
        try { bot.pathfinder.setGoal(null); } catch {}
        try { bot.stopDigging(); } catch {}
        try { bot.clearControlStates(); } catch {}
      }
    } catch {}
  }, 700);
  return iv;
}
class Interrupt extends Error {}
function guard() {
  if (rt.danger && rt.danger.dist <= 12) throw new Interrupt('danger:' + rt.danger.name);
}
async function flee(bot) {
  rt.interrupts++; rt.flees++;
  const d = rt.danger;
  const name = d ? d.name : 'something';
  setIntent('Fleeing ' + name, 'survival', 'flee');
  say(bot, name === 'creeper' ? 'Creeper — back, back, back!' : (name.charAt(0).toUpperCase() + name.slice(1)) + ' — moving!', true);
  log('FLEE from', name, 'dist', d && d.dist);
  for (let i = 0; i < 3; i++) {
    // Run for home ground: known, high, and his.
    const g = await prims.gotoNear(bot, HOME.x, HOME.y, HOME.z, 3.0, 9000);
    await prims.sleep(1500);
    const h = nearestHostile(bot, 13);
    if (!h) break;
    if (g.ok && distHome(bot) <= 4) { await prims.sleep(3000); if (!nearestHostile(bot, 13)) break; }
  }
  await prims.sleep(2000);
  log('flee done; danger now', JSON.stringify(nearestHostile(bot, 16)));
}

