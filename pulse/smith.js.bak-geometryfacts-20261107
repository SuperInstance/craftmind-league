'use strict';
/**
 * smith.js — the Pulse's smith: a Voyager-pattern script author on a tick.
 *
 * One tick:
 *   1. Read the world as evidence: cody-state.json, evidence.json,
 *      curriculum.json, the pulse ledger (past trials + verdicts),
 *      and the tail of Cody's resident log.
 *   2. Ask the presence brain — THROUGH THE GOVERNOR, identity
 *      league-pulse-smith — for exactly ONE artefact: a new skill
 *      module or a revision of the current stage's script. The API
 *      surface in the prompt is extracted from the framework's real
 *      source (actions/index.js, prims.js, mineflayer's api.md),
 *      never from the smith-operator's memory.
 *   3. Extract the code, syntax-check it (node --check) and shape-test
 *      it (child-process require: meta.stage matches, run is a
 *      function). Failures are stored as evidence, not hidden.
 *   4. Store the candidate in pulse/library/ with a header sidecar
 *      (stage, tick, parent, the smith's own rationale). A candidate
 *      becomes Cody ONLY through trial.js's evidence gate.
 *
 * Usage:
 *   node smith.js tick [--stage S1]   — one tick now
 *   node smith.js loop                — tick every 10 min; a FAIL
 *                                       verdict in the ledger triggers
 *                                       an early tick
 */
const fs = require('fs');
const path = require('path');
const { execFileSync } = require('child_process');

const PULSE = '/home/caseydigennaro/craftmind-league/pulse';
const LEAGUE = '/home/caseydigennaro/craftmind-league';
const CM_SRC = path.join(LEAGUE, 'bots/craftmind/src');
const CM_MOD = path.join(LEAGUE, 'bots/craftmind/node_modules');
const GOVERNOR = 'http://127.0.0.1:8642/v1/chat/completions';
const IDENTITY = 'league-pulse-smith';
const MODEL = 'confluence-presence-brain';

const readJson = (p, d) => { try { return JSON.parse(fs.readFileSync(p, 'utf8')); } catch { return d; } };
const tail = (p, n) => { try { return fs.readFileSync(p, 'utf8').split('\n').slice(-n).join('\n'); } catch { return ''; } };

// ── API surface extraction (from real source) ────────────────────────
function extractActions() {
  const src = fs.readFileSync(path.join(CM_SRC, 'actions', 'index.js'), 'utf8');
  const out = [];
  const re = /^\s{2}(\w+): \{\n\s+description: '([^']+)'/gm;
  let m;
  while ((m = re.exec(src))) out.push(`- ${m[1]}: ${m[2]}`);
  return out.join('\n');
}

function extractPrims() {
  const src = fs.readFileSync(path.join(PULSE, 'lib', 'prims.js'), 'utf8');
  return src.split('\n').filter((l) => l.startsWith('// prim:')).map((l) => '- ' + l.replace('// prim: ', '')).join('\n');
}

function extractMineflayer() {
  const apiPath = path.join(CM_MOD, 'mineflayer', 'docs', 'api.md');
  if (!fs.existsSync(apiPath)) return '(mineflayer api.md not found on this bench)';
  const md = fs.readFileSync(apiPath, 'utf8');
  const wants = ['bot.dig(', 'bot.craft(', 'bot.placeBlock(', 'bot.equip(', 'bot.findBlocks(', 'bot.blockAt(', 'bot.inventory', 'bot.openChest(', 'bot.pathfinder', 'bot.time', 'bot.entities', 'bot.recipesFor('];
  const lines = md.split('\n');
  const picked = [];
  for (let i = 0; i < lines.length; i++) {
    if (lines[i].startsWith('### ') && wants.some((w) => lines[i].includes(w))) {
      picked.push(lines.slice(i, i + 5).join('\n'));
    }
  }
  return picked.join('\n\n').slice(0, 1600);
}

function apiSurface(withActions = true) {
  const parts = [
    '## SEEDED PRIMITIVES — ctx.prims (compose these first)',
    extractPrims(),
    '',
  ];
  if (withActions) {
    parts.push('## FRAMEWORK ACTION NAMES (same operations exist inside the framework; your ctx.bot covers them via mineflayer)', extractActions(), '');
  }
  parts.push(
    '## MINEFLAYER ESSENTIALS — from node_modules/mineflayer/docs/api.md',
    extractMineflayer(),
    '',
    '## YOUR ctx OBJECT',
    '- ctx.bot: mineflayer bot (bot.entity.position, bot.health, bot.food, bot.inventory.items(), bot.blockAt(vec3), bot.findBlocks({matching, maxDistance, count}), bot.chat(msg), bot.time.timeOfDay 0..24000).',
    '- ctx.prims: the primitives above. ctx.Vec3: new ctx.Vec3(x,y,z), .offset(x,y,z). ctx.anchor: {x,y,z} home anchor. ctx.stage: stage id. ctx.log(...): pulse log.'
  );
  return parts.join('\n');
}

// ── prompt ───────────────────────────────────────────────────────────
function buildPrompt(stage, parentSource) {
  const state = readJson(path.join(PULSE, 'cody-state.json'), {});
  const evidence = readJson(path.join(PULSE, 'evidence.json'), {});
  const ledger = tail(path.join(PULSE, 'ledger.jsonl'), 8);
  const failures = ledger.split('\n').filter(Boolean).map((l) => { try { return JSON.parse(l); } catch { return null; } })
    .filter((e) => e && e.stage === stage.id && e.kind === 'trial');
  const residentLog = tail(path.join(LEAGUE, 'logs', 'resident-cody.log'), 40)
    .split('\n').filter((l) => /PULSE|RESIDENT|error|Error|died|death/i.test(l)).slice(-18).join('\n');

  const system = [
    'You are the SMITH in a Voyager-pattern agent system. A Minecraft bot named Cody (a mineflayer client running the CraftMind framework) lives in a survival world and climbs a staged curriculum: settle in. You do not control Cody directly. You write ONE JavaScript skill module; a runner inside Cody executes it repeatedly; a separate gate process judges success ONLY from world evidence (inventory snapshots, block scans, server logs) — never from what your script claims.',
    '',
    'OUTPUT CONTRACT — reply with exactly this shape and nothing else:',
    'RATIONALE: <1-3 sentences: what you changed and why, given the evidence>',
    '```js',
    'module.exports = {',
    "  meta: { name: '<stage>-<short-name>', stage: '" + stage.id + "', summary: '<one line>' },",
    '  run: async (ctx) => { /* your code */ return { done: true }; }',
    '};',
    '```',
    '',
    'HARD RULES:',
    '1. Every skill is an IDEMPOTENT ENSURE: first check whether the stage goal already holds (inventory / world state) and return { done: true } immediately if it does. The runner loops your skill forever; partial progress must never be redone destructively.',
    '2. NO require() / import — everything you need is on ctx (see the API surface). CommonJS module.exports only.',
    '3. Use ctx.prims for movement, digging, crafting, placing — they are timeout-guarded and never throw. Check every result: if (r.ok) ... else log and adapt (e.g. move elsewhere, try another tree). Raw bot calls may throw: wrap risky ones in try/catch.',
    '4. Keep one run() under ~8 minutes of game time. Prefer several small loops with progress checks over one giant sequence.',
    '5. At most 2 ctx.prims.say() calls per run, and only for real milestones.',
    '6. Item and block names are minecraft-data names: oak_log, oak_planks, stick, crafting_table, wooden_pickaxe, cobblestone, stone_pickaxe, chest, torch, coal, oak_door. Trees near the anchor are oak/birch (any *_log works for planks of that type — match the wood type you cut when crafting planks: oak_log -> oak_planks).',
    '7. Deaths happen (hostile mobs): if Cody dies he respawns at the anchor and LOSES his carried inventory where he died. Your skill must cope: re-check state from scratch each run and re-gather what is missing.',
    '',
    apiSurface(!parentSource),
  ].join('\n');

  const user = [
    `## STAGE ${stage.id} — ${stage.title}`,
    stage.goal,
    `Evidence the gate will use: ${stage.evidence}`,
    '',
    '## ENVIRONMENT FACTS (server rules — plan around them)',
    `- World spawn point: ${state.spawnPoint ? JSON.stringify(state.spawnPoint) : 'near the anchor'}. The server runs spawn-protection=16: within 16 blocks (x/z plane) of the world spawn, a non-op player CANNOT break or place blocks — digs silently revert and placements fail. Cody is NOT op. His home anchor is ${state.anchor ? JSON.stringify(state.anchor) : 'unknown'}, close to spawn, so the nearest trees and the anchor clearing are likely INSIDE the protected circle.`,
    '- Therefore: travel OUTSIDE the protected circle (x/z distance from spawn > 17) to gather and to build. The shelter must still be within ~24 blocks of the anchor — pick a site on the far side of the anchor from spawn so both constraints hold.',
    '- When a dig or place keeps failing at one spot, MOVE — do not retry the same block.',
    '',
    '- RECIPE FACTS (Minecraft rules - the trial evidence shows these being missed): a crafting_table is an ITEM: it must be CRAFTED from 4 planks (craftByName) into the inventory BEFORE it can be placed; placeOnTop/placeAgainst fail with "no crafting_table in inventory" until then. placeOnTop(bot, item, refPos) places the item ON TOP of the block at refPos - the placed block lands at refPos + (0,1,0); pass a ground block BESIDE Cody, and the table position for later crafting is that landing cell, not the ground under his feet. A wooden_pickaxe is a 3x3 recipe: craft it with craftByName(bot, "wooden_pickaxe", 1, tablePos) where tablePos is the position of the PLACED table block. The full S1 chain needs at least 9 planks = 3 logs: 4 for the table, 2 per stick batch (sticks come in batches of 4), 3 for the pickaxe head - do not convert all planks to sticks before the table exists.',
    '',
    '## CODY RIGHT NOW (state feed)',
    JSON.stringify(state).slice(0, 1500),
    '',
    '## WORLD EVIDENCE SCAN (latest)',
    JSON.stringify(evidence).slice(0, 1100),
    '',
    '## PAST TRIALS FOR THIS STAGE (newest last)',
    failures.length ? failures.map((f) => `- ${f.ts} candidate ${path.basename(f.candidate || '?')} verdict ${f.verdict} evidence: ${JSON.stringify(f.evidence).slice(0, 500)}`).join('\n') : '(none yet)',
    '',
    '## RECENT RESIDENT LOG LINES',
    residentLog || '(none)',
    parentSource ? '\n## CURRENT SCRIPT FOR THIS STAGE (revise it — keep what worked, fix what the evidence shows)\n```js\n' + parentSource.slice(0, 2600) + '\n```' : '',
    '',
    failures.length
      ? 'Write a REVISION of the current script that fixes what the trial evidence shows. Do not start over unless the evidence says the whole approach failed.'
      : 'Write the first skill for this stage.',
  ].join('\n');

  return { system, user };
}

// ── governor call ────────────────────────────────────────────────────
async function callSmith(system, user) {
  const res = await fetch(GOVERNOR, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + IDENTITY },
    body: JSON.stringify({
      model: MODEL,
      messages: [
        { role: 'system', content: system },
        { role: 'user', content: user },
      ],
      temperature: 0.35,
      max_tokens: 1750,
    }),
    signal: AbortSignal.timeout(240000),
  });
  if (!res.ok) throw new Error('governor HTTP ' + res.status + ': ' + (await res.text()).slice(0, 300));
  const data = await res.json();
  return data.choices && data.choices[0] && data.choices[0].message ? data.choices[0].message.content : '';
}

function governorReceipt() {
  const lines = tail(path.join(LEAGUE, 'ledger', 'mind-calls.jsonl'), 30).split('\n').filter(Boolean);
  for (let i = lines.length - 1; i >= 0; i--) {
    try { const j = JSON.parse(lines[i]); if (j.agent === 'pulse-smith') return j; } catch {}
  }
  return null;
}

// ── extraction + validation ──────────────────────────────────────────
function extract(reply) {
  const rat = reply.match(/RATIONALE:\s*(.+)/);
  const fence = reply.match(/```(?:js|javascript)\n([\s\S]*?)```/);
  return { rationale: rat ? rat[1].trim() : '', code: fence ? fence[1] : null };
}

function validate(code, stageId, tmpFile) {
  fs.writeFileSync(tmpFile, code);
  execFileSync(process.execPath, ['--check', tmpFile], { timeout: 15000 });
  const shapeSrc = `
    const m = require(${JSON.stringify(tmpFile)});
    if (!m || typeof m !== 'object') throw new Error('module did not export an object');
    if (!m.meta || m.meta.stage !== ${JSON.stringify(stageId)}) throw new Error('meta.stage mismatch: ' + (m.meta && m.meta.stage));
    if (typeof m.run !== 'function') throw new Error('run is not a function');
    console.log('SHAPE-OK ' + (m.meta.name || '?'));
  `;
  const out = execFileSync(process.execPath, ['-e', shapeSrc], { timeout: 15000 }).toString();
  return out.trim();
}

// ── one tick ─────────────────────────────────────────────────────────
async function tick(stageOverride) {
  const curr = readJson(path.join(PULSE, 'curriculum.json'), { stages: [] });
  const active = readJson(path.join(PULSE, 'active.json'), { stages: {} });
  const stage = stageOverride
    ? curr.stages.find((s) => s.id === stageOverride)
    : curr.stages.find((s) => s.status !== 'passed');
  if (!stage) { console.log('SMITH: curriculum complete — no stage to write for'); return null; }

  // Parent: last candidate or the promoted skill for this stage.
  const libDir = path.join(PULSE, 'library');
  fs.mkdirSync(libDir, { recursive: true });
  const siblings = fs.readdirSync(libDir).filter((f) => f.startsWith(stage.id.toLowerCase() + '-') && f.endsWith('.js')).sort();
  const promoted = active.stages && active.stages[stage.id] && active.stages[stage.id].skill;
  const parentPath = promoted || (siblings.length ? path.join(libDir, siblings[siblings.length - 1]) : null);
  const parentSource = parentPath && fs.existsSync(parentPath) ? fs.readFileSync(parentPath, 'utf8') : null;

  const { system, user } = buildPrompt(stage, parentSource);
  console.log(`SMITH TICK stage=${stage.id} parent=${parentPath ? path.basename(parentPath) : '(none)'} promptChars=${system.length + user.length}`);
  const reply = await callSmith(system, user);
  const receipt = governorReceipt();
  console.log('SMITH governor receipt:', JSON.stringify(receipt));

  const stamp = new Date().toISOString().replace(/[:.]/g, '-');
  const { rationale, code } = extract(reply);
  if (!code) {
    const rawPath = path.join(libDir, `${stage.id.toLowerCase()}-rawfail-${stamp}.txt`);
    fs.writeFileSync(rawPath, reply);
    console.log('SMITH EXTRACTION FAILED — raw reply stored at', rawPath);
    fs.appendFileSync(path.join(PULSE, 'library', 'ticks.jsonl'), JSON.stringify({ ts: new Date().toISOString(), stage: stage.id, ok: false, error: 'no code fence in reply', rawPath, receipt }) + '\n');
    return { ok: false, error: 'extraction', rawPath };
  }

  const file = path.join(libDir, `${stage.id.toLowerCase()}-${stamp}.js`);
  try {
    const shape = validate(code, stage.id, file + '.tmp.js');
    fs.writeFileSync(file, code);
    fs.unlinkSync(file + '.tmp.js');
    const header = {
      file, stage: stage.id, tick: new Date().toISOString(), parent: parentPath,
      rationale, model: MODEL, identity: IDENTITY, governorReceipt: receipt, shape,
    };
    fs.writeFileSync(file.replace(/\.js$/, '.json'), JSON.stringify(header, null, 1));
    fs.appendFileSync(path.join(PULSE, 'library', 'ticks.jsonl'), JSON.stringify({ ts: header.tick, stage: stage.id, ok: true, file, rationale }) + '\n');
    console.log('SMITH CANDIDATE:', file);
    console.log('SMITH RATIONALE:', rationale);
    return { ok: true, file, rationale, receipt };
  } catch (e) {
    fs.writeFileSync(file.replace(/\.js$/, '.invalid.js'), code);
    console.log('SMITH VALIDATION FAILED:', e.message);
    fs.appendFileSync(path.join(PULSE, 'library', 'ticks.jsonl'), JSON.stringify({ ts: new Date().toISOString(), stage: stage.id, ok: false, error: 'validation: ' + e.message, receipt }) + '\n');
    return { ok: false, error: 'validation: ' + e.message };
  }
}

// ── main ─────────────────────────────────────────────────────────────
(async () => {
  const cmd = process.argv[2] || 'tick';
  const stageIdx = process.argv.indexOf('--stage');
  const stage = stageIdx >= 0 ? process.argv[stageIdx + 1] : null;
  if (cmd === 'tick') {
    const r = await tick(stage);
    process.exit(r && r.ok ? 0 : 1);
  } else if (cmd === 'loop') {
    console.log('SMITH loop: tick every 10 min + on FAIL verdicts');
    let lastLedgerSize = 0;
    const ledgerPath = path.join(PULSE, 'ledger.jsonl');
    setInterval(async () => {
      try {
        const st = fs.existsSync(ledgerPath) ? fs.statSync(ledgerPath).size : 0;
        if (st !== lastLedgerSize) {
          const fresh = tail(ledgerPath, 3);
          lastLedgerSize = st;
          if (/\"verdict\": \"FAIL\"/.test(fresh) || /\"verdict\":\"FAIL\"/.test(fresh)) {
            console.log('SMITH loop: FAIL verdict seen — early tick');
            await tick(null);
          }
        }
      } catch (e) { console.log('SMITH loop watch error:', e.message); }
    }, 30000);
    for (;;) { await tick(null); await new Promise((r) => setTimeout(r, 10 * 60 * 1000)); }
  } else {
    console.error('usage: node smith.js tick [--stage S1] | loop');
    process.exit(2);
  }
})().catch((e) => { console.error('SMITH FATAL:', e.message); process.exit(1); });
