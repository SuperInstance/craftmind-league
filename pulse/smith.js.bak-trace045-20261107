  if (cmd === 'tick') {
    const r = await tick(stage);
    process.exit(r && r.ok ? 0 : 1);
  } else if (cmd === 'loop') {
    console.log('SMITH loop: tick every 10 min + on FAIL verdicts');
    let lastLedgerSize = 0;
    const ledgerPath = path.join(PULSE, 'ledger.jsonl');
    setInterval(async () => {
      try {
        const st = fs.existsSync(ledgerPath) ? fs.statSync(ledgerPath).size : 0;
        if (st !== lastLedgerSize) {
          const fresh = tail(ledgerPath, 3);
          lastLedgerSize = st;
          if (/\"verdict\": \"FAIL\"/.test(fresh) || /\"verdict\":\"FAIL\"/.test(fresh)) {
            console.log('SMITH loop: FAIL verdict seen — early tick');
            await tick(null);
          }
        }
      } catch (e) { console.log('SMITH loop watch error:', e.message); }
    }, 30000);
    for (;;) { await tick(null); await new Promise((r) => setTimeout(r, 10 * 60 * 1000)); }
  } else {
    console.error('usage: node smith.js tick [--stage S1] | loop');
    process.exit(2);
  }
})().catch((e) => { console.error('SMITH FATAL:', e.message); process.exit(1); });
