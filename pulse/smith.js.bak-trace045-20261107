// ── governor call ────────────────────────────────────────────────────
async function callSmith(system, user) {
  const res = await fetch(GOVERNOR, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + IDENTITY },
    body: JSON.stringify({
      model: MODEL,
      messages: [
        { role: 'system', content: system },
        { role: 'user', content: user },
      ],
      temperature: 0.35,
      max_tokens: 3200,
    }),
    signal: AbortSignal.timeout(240000),
  });
  if (!res.ok) throw new Error('governor HTTP ' + res.status + ': ' + (await res.text()).slice(0, 300));
  const data = await res.json();
  return data.choices && data.choices[0] && data.choices[0].message ? data.choices[0].message.content : '';
}

function governorReceipt() {
  const lines = tail(path.join(LEAGUE, 'ledger', 'mind-calls.jsonl'), 30).split('\n').filter(Boolean);
  for (let i = lines.length - 1; i >= 0; i--) {
    try { const j = JSON.parse(lines[i]); if (j.agent === 'pulse-smith') return j; } catch {}
  }
  return null;
}

// ── extraction + validation ──────────────────────────────────────────
function extract(reply) {
  const rat = reply.match(/RATIONALE:\s*(.+)/);
  const fence = reply.match(/```(?:js|javascript)\n([\s\S]*?)```/);
  return { rationale: rat ? rat[1].trim() : '', code: fence ? fence[1] : null };
}

function validate(code, stageId, tmpFile) {
  fs.writeFileSync(tmpFile, code);
  execFileSync(process.execPath, ['--check', tmpFile], { timeout: 15000 });
  const shapeSrc = `
    const m = require(${JSON.stringify(tmpFile)});
    if (!m || typeof m !== 'object') throw new Error('module did not export an object');
    if (!m.meta || m.meta.stage !== ${JSON.stringify(stageId)}) throw new Error('meta.stage mismatch: ' + (m.meta && m.meta.stage));
    if (typeof m.run !== 'function') throw new Error('run is not a function');
    console.log('SHAPE-OK ' + (m.meta.name || '?'));
  `;
  const out = execFileSync(process.execPath, ['-e', shapeSrc], { timeout: 15000 }).toString();
  return out.trim();
}

// ── one tick ─────────────────────────────────────────────────────────
async function tick(stageOverride) {
  const curr = readJson(path.join(PULSE, 'curriculum.json'), { stages: [] });
  const active = readJson(path.join(PULSE, 'active.json'), { stages: {} });
  const stage = stageOverride
    ? curr.stages.find((s) => s.id === stageOverride)
    : curr.stages.find((s) => s.status !== 'passed');
  if (!stage) { console.log('SMITH: curriculum complete — no stage to write for'); return null; }

  // Parent: last candidate or the promoted skill for this stage.
  const libDir = path.join(PULSE, 'library');
  fs.mkdirSync(libDir, { recursive: true });
  const siblings = fs.readdirSync(libDir).filter((f) => f.startsWith(stage.id.toLowerCase() + '-') && f.endsWith('.js')).sort();
  const promoted = active.stages && active.stages[stage.id] && active.stages[stage.id].skill;
  const parentPath = promoted || (siblings.length ? path.join(libDir, siblings[siblings.length - 1]) : null);
  const parentSource = parentPath && fs.existsSync(parentPath) ? fs.readFileSync(parentPath, 'utf8') : null;

  const { system, user } = buildPrompt(stage, parentSource);
  console.log(`SMITH TICK stage=${stage.id} parent=${parentPath ? path.basename(parentPath) : '(none)'} promptChars=${system.length + user.length}`);
  const reply = await callSmith(system, user);
  const receipt = governorReceipt();
  console.log('SMITH governor receipt:', JSON.stringify(receipt));

  const stamp = new Date().toISOString().replace(/[:.]/g, '-');
  const { rationale, code } = extract(reply);
  if (!code) {
    const rawPath = path.join(libDir, `${stage.id.toLowerCase()}-rawfail-${stamp}.txt`);
    fs.writeFileSync(rawPath, reply);
    console.log('SMITH EXTRACTION FAILED — raw reply stored at', rawPath);
    fs.appendFileSync(path.join(PULSE, 'library', 'ticks.jsonl'), JSON.stringify({ ts: new Date().toISOString(), stage: stage.id, ok: false, error: 'no code fence in reply', rawPath, receipt }) + '\n');
    return { ok: false, error: 'extraction', rawPath };
  }

  const file = path.join(libDir, `${stage.id.toLowerCase()}-${stamp}.js`);
  try {
    const shape = validate(code, stage.id, file + '.tmp.js');
    fs.writeFileSync(file, code);
    fs.unlinkSync(file + '.tmp.js');
    const header = {
      file, stage: stage.id, tick: new Date().toISOString(), parent: parentPath,
      rationale, model: MODEL, identity: IDENTITY, governorReceipt: receipt, shape,
    };
    fs.writeFileSync(file.replace(/\.js$/, '.json'), JSON.stringify(header, null, 1));
    fs.appendFileSync(path.join(PULSE, 'library', 'ticks.jsonl'), JSON.stringify({ ts: header.tick, stage: stage.id, ok: true, file, rationale }) + '\n');
    console.log('SMITH CANDIDATE:', file);
    console.log('SMITH RATIONALE:', rationale);
    return { ok: true, file, rationale, receipt };
  } catch (e) {
    fs.writeFileSync(file.replace(/\.js$/, '.invalid.js'), code);
    console.log('SMITH VALIDATION FAILED:', e.message);
    fs.appendFileSync(path.join(PULSE, 'library', 'ticks.jsonl'), JSON.stringify({ ts: new Date().toISOString(), stage: stage.id, ok: false, error: 'validation: ' + e.message, receipt }) + '\n');
    return { ok: false, error: 'validation: ' + e.message };
  }
}

